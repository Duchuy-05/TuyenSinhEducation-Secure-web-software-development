# Local secrets; safe example configuration may be shipped.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Installed dependencies, temporary caches, and generated outputs.
**/node_modules
**/.npm-cache
**/dist
**/coverage
**/.nyc_output
**/logs
**/*.log

# Version-control metadata.
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules

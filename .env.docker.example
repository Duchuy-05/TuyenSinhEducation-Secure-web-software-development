# Copy this file to .env in the repository root and replace all placeholder secrets.
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=tuyensinh
MYSQL_USER=tuyensinh_app
MYSQL_PASSWORD=change_app_password

# Required by backend/src/config/env.ts
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_refresh_secret

# Required by current startup validation even if payment is not being tested yet
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
